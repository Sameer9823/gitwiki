# Database (canonical store)
DATABASE_URL="postgresql://user:password@localhost:5432/gitwiki?schema=public"

# NextAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub (fallback token if a user hasn't connected their own OAuth token / for public repos)
GITHUB_TOKEN=

# Max files indexed per repo (default 800 if unset). Files beyond this are
# skipped and the indexing run is flagged as truncated in logs/results.
MAX_INDEX_FILES=800

# Secret configured on the GitHub webhook (repo Settings → Webhooks). Required
# for push-triggered incremental indexing and PR review to work at all — the
# webhook must also be subscribed to "Pushes" and "Pull requests" events.
GITHUB_WEBHOOK_SECRET=

# Set to "false" to disable posting automated PR review comments while
# leaving push-triggered indexing on (default: enabled).
PR_REVIEW_ENABLED=

# Set to "false" to skip the wiki critic's review/revision pass and use the
# writer's first draft directly (default: enabled). Saves one LLM call per
# page (two if a revision is triggered) at the cost of catching fewer
# unsupported claims — see src/lib/wiki/critic.ts.
WIKI_CRITIC_ENABLED=

# OpenAI
OPENAI_API_KEY=

# Pinecone (vector projection — not the canonical store)
PINECONE_API_KEY=
PINECONE_INDEX=git-wiki

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
